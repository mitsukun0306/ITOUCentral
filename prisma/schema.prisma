// ITOUCentral データベーススキーマ
// 開発中は SQLite。将来サーバー運用時は datasource を postgresql に変更するだけで移行可能。

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW // 完了申請中(メンバーが申請 → 管理者が承認で DONE へ)
  DONE
}

enum PayrollMethod {
  TASK_FIXED // タスクごとに設定した報酬方式で算出し合算
  UNIT_QUANTITY // 旧「単価 × 成果量 の合算」。現在は TASK_FIXED と同じくタスク別方式で合算(過去レコード互換のため残置)
  MONTHLY_MANUAL // 月ごとに手入力で確定
}

/// タスクごとの報酬方式
enum TaskRewardType {
  FIXED // 固定報酬
  DEPOSIT_UNIT // 手付金 + 単価 × 成果量
}

enum PayrollStatus {
  DRAFT
  CONFIRMED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ユーザー(管理者 / メンバー=業務委託者)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks       Task[]
  attendances Attendance[]
  payrolls    Payroll[]
  expenses    ExpenseRequest[]
  meals       MealRecord[]
  deductions  PayrollDeduction[]
}

/// タスク(成果報酬の元データ)
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  // 報酬方式(タスクごとに選択)と入力値
  rewardType  TaskRewardType @default(FIXED)
  fixedReward Int            @default(0) // FIXED: タスク固定報酬(円)
  deposit     Int            @default(0) // DEPOSIT_UNIT: 手付金(円)
  unitPrice   Int            @default(0) // DEPOSIT_UNIT: 単価(円)
  quantity    Int            @default(0) // DEPOSIT_UNIT: 成果量

  // 支給月(管理者が指定。未指定なら完了月に計上)
  payoutYear  Int?
  payoutMonth Int?

  // 納品遅延による報酬の支給率(%)。未設定なら既定(24h:50 / 3日未満:1/3 / 3日以降:0)。
  penalty24   Int? // 超過24時間以内
  penalty72   Int? // 超過3日未満
  penaltyOver Int? // 超過3日以降

  dueDate     DateTime?
  submittedAt DateTime? // 完了申請した時刻(報酬の仮確定・期限カウント停止の基準)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([payoutYear, payoutMonth])
}

/// 勤怠
model Attendance {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate DateTime // 対象日(0時基準)
  clockIn  DateTime?
  clockOut DateTime?
  breakMin Int       @default(0) // 休憩(分)。勤務時間から自動算出。
  note     String?

  // メンバーからの時刻変更申請(管理者承認で反映)
  editRequested Boolean   @default(false)
  reqClockIn    DateTime?
  reqClockOut   DateTime?
  reqNote       String?
  reqAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workDate])
  @@index([userId])
}

/// 給与(月次)
model Payroll {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  method      PayrollMethod
  amount      Int           @default(0) // 計算結果 or 手入力額
  note        String?
  status      PayrollStatus @default(DRAFT)
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, year, month])
  @@index([year, month])
}

/// 給与からの天引き(管理者が設定。対象給与月の支給額から差し引く)
model PayrollDeduction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int // 対象給与月(年)
  month       Int // 対象給与月(月)
  label       String // 項目名(例: 前払い金の精算)
  amount      Int // 天引き額(円・正の整数)
  note        String? // 備考(メンバーにも表示)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, year, month])
  @@index([year, month])
}

/// アプリ全体設定(1レコードのみ)
model Setting {
  id                   Int           @id @default(1)
  companyName          String        @default("いとう開発部")
  defaultPayrollMethod PayrollMethod @default(TASK_FIXED)
  /// 福利厚生の各項目を提供中か(false のときはメンバーに「ごめんなさい」表示)
  benefitRetreatEnabled Boolean      @default(true)
  benefitExpenseEnabled Boolean      @default(true)
  benefitMealEnabled    Boolean      @default(true)
  updatedAt            DateTime      @updatedAt
}

/// 福利厚生: リトリートイベント(管理者が登録)
model RetreatEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
}

/// 福利厚生: 食事補助の記録(メンバーが日々申請。領収書の写真を添付する運用)
model MealRecord {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime // 食事日
  amount       Int           @default(0) // 食費(円)
  item         String? // 旧フォームの入力(廃止。過去データ表示用に残置)
  place        String? // 旧フォームの入力(廃止。過去データ表示用に残置)
  receiptImage Bytes? // 領収書の写真(ブラウザ側で圧縮済み)
  receiptMime  String? // 領収書画像のMIMEタイプ
  status       ExpenseStatus @default(PENDING) // 管理者の承認/却下。承認済みのみ報酬に計上
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([userId, date])
  @@index([status])
  @@index([status, decidedAt])
}

/// 操作ログ(監査用)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String // 実行者名のスナップショット
  action    String // 操作の種別(例: タスク作成)
  detail    String? // 補足
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 福利厚生: 経費申請(メンバーが申請 → 管理者が承認/却下)
model ExpenseRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  amount      Int           @default(0) // 金額(円)
  category    String?
  incurredOn  DateTime? // 発生日
  note        String?
  status      ExpenseStatus @default(PENDING)
  decidedAt   DateTime?
  decidedNote String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}
